#include <stdio.h>
#include <string.h>

struct book
{
    int id;
    char name[50];
    char author[50];
    int available;
};

struct book b[100];
int count = 0;

void addBook()
{
    printf("Enter Book ID: ");
    scanf("%d",&b[count].id);

    printf("Enter Book Name: ");
    scanf("%s",b[count].name);

    printf("Enter Author Name: ");
    scanf("%s",b[count].author);

    b[count].available = 1;
    count++;

    printf("Book Added Successfully\n");
}

void displayBooks()
{
    int i;

    for(i=0;i<count;i++)
    {
        printf("\nBook ID: %d",b[i].id);
        printf("\nBook Name: %s",b[i].name);
        printf("\nAuthor: %s",b[i].author);

        if(b[i].available==1)
        printf("\nStatus: Available\n");
        else
        printf("\nStatus: Issued\n");
    }
}

void issueBook()
{
    int id,i;

    printf("Enter Book ID to Issue: ");
    scanf("%d",&id);

    for(i=0;i<count;i++)
    {
        if(b[i].id==id && b[i].available==1)
        {
            b[i].available=0;
            printf("Book Issued Successfully\n");
            return;
        }
    }

    printf("Book Not Available\n");
}

void returnBook()
{
    int id,i;

    printf("Enter Book ID to Return: ");
    scanf("%d",&id);

    for(i=0;i<count;i++)
    {
        if(b[i].id==id)
        {
            b[i].available=1;
            printf("Book Returned Successfully\n");
            return;
        }
    }

    printf("Invalid Book ID\n");
}

int main()
{
    int choice;

    while(1)
    {
        printf("\n--- BOOKTRACK LIBRARY SYSTEM ---\n");
        printf("1. Add Book\n");
        printf("2. Display Books\n");
        printf("3. Issue Book\n");
        printf("4. Return Book\n");
        printf("5. Exit\n");

        printf("Enter Choice: ");
        scanf("%d",&choice);

        switch(choice)
        {
            case 1: addBook(); break;
            case 2: displayBooks(); break;
            case 3: issueBook(); break;
            case 4: returnBook(); break;
            case 5: return 0;
            default: printf("Invalid Choice\n");
        }
    }
}